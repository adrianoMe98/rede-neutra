# Alternativa para ambientes cujo build Docker não tem acesso DNS/Internet.
# Baixe antes com: .venv/bin/pip download --only-binary=:all: -r requirements.txt -d .wheelhouse
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY requirements.txt .
COPY .wheelhouse /wheels
RUN pip install --no-index --find-links=/wheels -r requirements.txt && rm -rf /wheels && groupadd --gid 10001 erp && useradd --uid 10001 --gid erp --no-create-home erp
COPY config config
COPY network network
COPY templates templates
COPY static static
COPY scripts scripts
COPY manage.py .env.example ./
RUN mkdir -p /app/data /app/staticfiles && chown -R erp:erp /app
USER erp
EXPOSE 8000
CMD ["sh", "scripts/entrypoint.sh"]
